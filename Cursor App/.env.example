# Server-side API keys (used by server and Vercel serverless). Do not use VITE_ prefix.
# Study guides require GEMINI_API_KEY.
# Get keys from: OpenAI https://platform.openai.com/api-keys | Gemini https://aistudio.google.com/app/apikey

OPENAI_API_KEY=
GEMINI_API_KEY=your_key_here

# Optional: free-tier friendly model (default tries 2.5-flash, then others)
GEMINI_MODEL=gemini-2.5-flash

# Required for sign-in (use a long random string, 16+ characters)
JWT_SECRET=change-this-to-a-long-random-secret

# Admin dashboard login
ADMIN_EMAIL=admin@studyhub.local
ADMIN_PASSWORD=change-this-admin-password
